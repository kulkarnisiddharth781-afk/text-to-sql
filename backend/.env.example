# Copy to .env and edit. Never commit .env.

# Option A (free): Groq. Get a key at https://console.groq.com/keys
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=PASTE_YOUR_GROQ_KEY_HERE

# Option B: OpenAI. Remove OPENAI_BASE_URL and LLM_REASONING_EFFORT above.
# LLM_MODEL=gpt-4o-mini

# Option C: Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=...

# Option D: Ollama (local, no key)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1

DATABASE_PATH=data/sample.db
MAX_ROWS=200
QUERY_TIMEOUT_S=5
MAX_RETRIES=2
CORS_ORIGINS=http://localhost:5173
